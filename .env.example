# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real keys.

# Supabase project settings -> Project URL
NEXT_PUBLIC_SUPABASE_URL=

# Supabase project settings -> API -> service_role key (server-only, never
# exposed to the browser — do NOT prefix this one with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Resend dashboard -> API Keys
RESEND_API_KEY=

# Who gets the contact form notification, comma-separated (server-only — do NOT
# prefix with NEXT_PUBLIC_). Leave blank to send to contact@corenovait.com.au.
# Example: CONTACT_TO_EMAILS=you@corenovait.com.au, partner@gmail.com
CONTACT_TO_EMAILS=

# Google Analytics 4 -> Admin -> Data Streams -> your web stream -> Measurement ID
# (starts with "G-"). Leave blank to disable analytics entirely.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
